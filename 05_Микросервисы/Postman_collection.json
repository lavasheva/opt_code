    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/users",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Student\", \"email\": \"student@example.test\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const body=pm.response.json();",
              "const vars=pm.collectionVariables.toObject();",
              "const headers={get:name=>pm.response.headers.get(name)};",
              "pm.collectionVariables.set(\"userId\",body.id);",
              "pm.test(\"body.name === \\\"Student\\\"\",()=>pm.expect(body.name === \"Student\").to.equal(true));"
            ]
          }
        }
      ]
    },
