      "body.product === \"Book\""
    ],
    "save": {}
  },
  {
    "name": "Read order cached",
    "method": "GET",
    "path": "/orders/{{orderId}}",
    "status": 200,
    "body": null,
    "checks": [
      "headers.get(\"x-cache\") === \"HIT\""
    ],
    "save": {}
  },
  {
    "name": "Update order",
    "method": "PUT",
    "path": "/orders/{{orderId}}",
    "status": 200,
    "body": {
      "userId": "{{userId}}",
      "product": "Notebook",
      "amount": 200
    },
    "checks": [],
    "save": {}
  },
  {
    "name": "Read updated order",
    "method": "GET",
    "path": "/orders/{{orderId}}",
    "status": 200,
    "body": null,
    "checks": [
      "body.amount === 200"
    ],
    "save": {}
  },
  {
    "name": "Aggregate user and orders",
    "method": "GET",
    "path": "/users/{{userId}}/details",
    "status": 200,
    "body": null,
    "checks": [
      "body.user.id === Number(vars.userId)",
      "body.orders.some(x=>x.id === Number(vars.orderId))"
    ],
    "save": {}
  },
  {
