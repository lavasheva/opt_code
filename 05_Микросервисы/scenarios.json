[
  {
    "name": "Create user",
    "method": "POST",
    "path": "/users",
    "status": 201,
    "body": {
      "name": "Student",
      "email": "student@example.test"
    },
    "checks": [
      "body.name === \"Student\""
    ],
    "save": {
      "userId": "id"
    }
  },
  {
    "name": "List users",
    "method": "GET",
    "path": "/users",
    "status": 200,
    "body": null,
    "checks": [
      "Array.isArray(body)",
      "body.some(x=>x.id === Number(vars.userId))"
    ],
    "save": {}
  },
  {
    "name": "Read user cold",
    "method": "GET",
    "path": "/users/{{userId}}",
    "status": 200,
    "body": null,
    "checks": [
      "body.id === Number(vars.userId)"
    ],
    "save": {}
  },
  {
    "name": "Read user cached",
    "method": "GET",
    "path": "/users/{{userId}}",
    "status": 200,
    "body": null,
    "checks": [
      "headers.get(\"x-cache\") === \"HIT\""
    ],
    "save": {}
  },
  {
    "name": "Update user invalidates cache",
    "method": "PUT",
    "path": "/users/{{userId}}",
    "status": 200,
    "body": {
      "name": "Updated"
    },
    "checks": [
      "body.name === \"Updated\""
    ],
    "save": {}
  },
  {
    "name": "Read updated user",
    "method": "GET",
    "path": "/users/{{userId}}",
    "status": 200,
    "body": null,
    "checks": [
      "body.name === \"Updated\"",
      "headers.get(\"x-cache\") === \"MISS\""
    ],
    "save": {}
  },
  {
    "name": "Create order",
    "method": "POST",
    "path": "/orders",
    "status": 201,
    "body": {
      "userId": "{{userId}}",
      "product": "Book",
      "amount": 150
    },
    "checks": [],
    "save": {
      "orderId": "id"
    }
  },
  {
    "name": "List orders",
    "method": "GET",
    "path": "/orders",
    "status": 200,
    "body": null,
    "checks": [
      "Array.isArray(body)"
    ],
    "save": {}
  },
  {
    "name": "Filter orders",
    "method": "GET",
    "path": "/orders?userId={{userId}}",
    "status": 200,
    "body": null,
    "checks": [
      "body.some(x=>x.id === Number(vars.orderId))",
      "body.every(x=>x.userId === Number(vars.userId))"
    ],
    "save": {}
  },
  {
    "name": "Read order",
    "method": "GET",
    "path": "/orders/{{orderId}}",
